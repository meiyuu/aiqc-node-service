{
    "tabWidth": 4,
    "printWidth": 120,
    "singleQuote": true,
    "jsxSingleQuote": true,
    "trailingComma": "all",
    "bracketSpacing":true,
    "bracketSameLine": false,
    "useTabs": false,
    "arrowParens": "always",
    "htmlWhitespaceSensitivity": "css",
    "requirePragma": false,
    "insertPragma": false,
    "proseWrap": "preserve",
    "enable": true,
    "semi": true
}